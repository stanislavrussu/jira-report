# Step 2: run the report on your machine.
# Copy to .env, replace everything in {braces}, then:  chmod 600 .env
# Load it with:  set -a; source .env; set +a
#
# The values below also appear in terraform/terraform.tfvars, which step 3 uses. Keep the
# two files in step: step 2 only rehearses step 3 if both describe the same project.
# Everything else has a default; see terraform/variables.tf.

# --- Jira ---
JIRA_BASE_URL=https://{your-site-name}.atlassian.net
JIRA_PROJECT_KEY={YOUR-KEY}

# --- Credentials ---
# To keep the token out of files entirely, leave it blank and export it per session instead:
#   read -rs "JIRA_API_TOKEN?Jira API token: "; export JIRA_API_TOKEN
JIRA_EMAIL={your-atlassian-email}
JIRA_API_TOKEN= # the long string Atlassian showed once, today ATATT... - not the name you gave it

# --- Email ---
# Both must be addresses you control: SES sends each a confirmation link. One Gmail inbox
# covers both - your.address@gmail.com sends, your.address+project.lead@gmail.com receives.
REPORT_SENDER={your-email-address}
REPORT_RECIPIENT={project-lead-email-address}

# --- Optional filters ---
# Comma-separated Jira names, for example Bug,Task. Empty counts everything.
JIRA_ISSUE_TYPES=
JIRA_PRIORITIES=

# --- Only here ---
# Not set locally. In Lambda it replaces the two credentials above, and Terraform
# sets it from name_prefix in variables.tf.
# JIRA_SECRET_ID=jira-report-weekly/credentials
